# Paste in Streamlit Cloud: Manage app → Settings → Secrets
# Do not commit real secrets.toml into GitHub.
[research4life]
username = "YOUR_INSTITUTIONAL_USERNAME"
password = "YOUR_INSTITUTIONAL_PASSWORD"

# Required for hosted/public app to prevent anonymous use of those credentials.
[app]
access_pin = "SET_A_LONG_PRIVATE_ACCESS_PIN_HERE"
